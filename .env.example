APP_ENV=development
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
FLASK_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DATABASE_PATH=bookings.db

# V2.1 persistent settings store.
# Leave empty locally: settings are stored in SQLite (DATABASE_PATH).
# On Render production set a PostgreSQL connection string here.
SETTINGS_DATABASE_URL=

